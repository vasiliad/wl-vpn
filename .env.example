# wl-vpn deployment configuration
# Copy to .env and fill in your values
# NEVER commit .env to git!

# ── Server IPs ────────────────────────────────────────────────────────────────
# MP80 (Israel / Exit Node) — public IPv4 for SSH
MP80_IP=100.68.139.8

# RUS2 (Russia / Client) — public IPv4 for SSH
RUS2_IP=46.29.164.96

# ── SSH Credentials ───────────────────────────────────────────────────────────
# Use SSH keys instead of passwords in production!
# These are only for password auth fallback
MP80_PASSWORD=your_mp80_root_password
RUS2_PASSWORD=your_rus2_root_password

# ── Network Configuration ─────────────────────────────────────────────────────
# MP80 public IPv6 (for RTP return path from server to client)
MP80_IPV6=2a00:a041:e442:7100:215:5dff:fe00:200

# RTP port (UDP) — must match on both sides
RTP_PORT=10080

# SMTP port (TCP) — Haraka listens on this
SMTP_PORT=2525

# TUN subnet (must be /30, same on both sides)
TUN_SUBNET=10.0.200.0/30
TUN_CLIENT_IP=10.0.200.1
TUN_SERVER_IP=10.0.200.2

# ── Crypto ────────────────────────────────────────────────────────────────────
# Pre-shared key (32 bytes hex) — generate with: openssl rand -hex 32
# MUST be identical on client and server
PSK_HEX=your_64_char_hex_string_here

# ── Haraka ────────────────────────────────────────────────────────────────────
# Path to Haraka plugins directory on MP80
HARAKA_PLUGINS_DIR=/usr/local/haraka/plugins

# ── Systemd ───────────────────────────────────────────────────────────────────
# Service names
SERVICE_CLIENT=wl-client
SERVICE_SERVER=wl-server
HARAKA_SERVICE=haraka_v10

# ── Logging (anti-disk-fill) ──────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Python internal rate limit: seconds between same message (0 = off)
LOG_RATE_LIMIT=5